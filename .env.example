# ---- Core ------------------------------------------------------------------------------
ANYROUTE_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
# pglite://.data/pglite (zero-setup, in-process Postgres) | postgres://user:pass@host:5432/anyroute
DATABASE_URL=pglite://.data/pglite
# Optional: enables Redis rate limits/cache and BullMQ jobs (required for multiple replicas)
REDIS_URL=
# >= 32 chars in production. Encrypts provider/BYOK keys and receipt keys at rest.
APP_SECRET=
# Operator token for /trpc operator procedures (>= 24 chars in production)
ADMIN_TOKEN=
LOG_LEVEL=info
# Behind exactly one reverse proxy/load balancer that appends X-Forwarded-For: true. Otherwise false
# (then every client behind a proxy would share one IP for rate limits; never true without a proxy).
TRUST_PROXY=false

# ---- Robinhood Chain ------------------------------------------------------------------------
CHAIN_ID=4663
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_CONFIRMATIONS=2
CHAIN_START_BLOCK=
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
USDG_EIP712_NAME=Global Dollar
USDG_EIP712_VERSION=1
# Contract addresses (from contracts/deployments/4663.json after deployment)
CREDITS_ADDRESS=
CALLPAY_ADDRESS=
PAYWITHSTOCK_ADDRESS=
PROVIDER_BOND_ADDRESS=
RECEIPT_ANCHOR_ADDRESS=
ROYALTY_ADDRESS=
ANYR_STAKING_ADDRESS=
PAYMASTER_ADDRESS=
CALLPAY_TREASURY=
# Hot keys for operational roles (fund with a little ETH for gas). Keep them in a secret store.
ROUTER_PRIVATE_KEY=                 # PayWithStock.payCall + relays EIP-3009 per-call payments
SETTLEMENT_PRIVATE_KEY=             # Credits.postSpentRoot/sweep, Royalty.stream, payouts, margin
ANCHORER_PRIVATE_KEY=               # ReceiptAnchor.anchor + signing-key registry
PAYMASTER_SIGNER_KEY=               # AnyrPaymaster verifying signer (ERC-7677 service)
SLASHER_PRIVATE_KEY=                # dev only; in production the 3-of-5 Safe executes slashes

# ---- Economics -----------------------------------------------------------------------------
PER_CALL_MARGIN_BPS=100             # <= 100 (1%), charged only on per-call (402) payments
PROVIDER_FEE_BPS=200                # 2% provider-side settlement fee (prepaid is 0% to callers)
BYOK_FEE_BPS=0
PER_CALL_MAX_USD=25
PER_CALL_QUOTE_TTL_S=300
# x402 (exact scheme): agents sign a USDG transferWithAuthorization to X402_PAY_TO and send it as X-PAYMENT; the router
# relays it (ROUTER_PRIVATE_KEY, funded with a little ETH for gas) and serves the call. Needs no CallPay contract.
# On when X402_PAY_TO is set to a wallet the operator controls (it is not a contract that indexes deposits).
X402_PAY_TO=
X402_NETWORK=robinhood-chain        # network name advertised in `accepts` (eip155:<CHAIN_ID> is accepted too)

# ---- Pay with Stock Tokens -------------------------------------------------------------------
# JSON list of registered Stock Tokens (see config/rhc-mainnet.json for verified addresses)
PAYWITH_TOKENS=[{"symbol":"NVDA","address":"0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC","decimals":18,"feed":"0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15"}]
PAYWITH_THRESHOLD_USD=1
PAYWITH_MAX_AGE_H=24
PAYWITH_MAX_DEBT_USD=5
PAYWITH_MAX_SLIP_BPS=100
PAYWITH_CAP_HAIRCUT_BPS=1000

# ---- Stock escrow payments (PAYMENTS_MODE=escrow) ---------------------------------------------
# Customers sign in with their wallet and transfer a listed Stock Token to ESCROW_ADDRESS (a wallet
# you control; only its public address goes here). Once the transfer's block is at or below the
# chain's ESCROW_FINALITY block (and has CHAIN_CONFIRMATIONS), the sending wallet's account is
# credited at the Chainlink price minus ESCROW_HAIRCUT_BPS; until then it shows as pending_finality.
# On Robinhood Chain `finalized` trails the head by ~15-21 minutes and `safe` by ~8-14 minutes.
# Credits are re-verified for ESCROW_REORG_HORIZON_BLOCKS (~1 day at ~10 blocks/s); one whose transfer
# left the canonical chain is reversed and flagged until escrow_deposits.reviewed_at is set.
# Runs without the Anyroute contracts, which must then be left unset. Set ESCROW_START_BLOCK to the
# block at or before the escrow address was first published, so no earlier transfer is missed.
PAYMENTS_MODE=contracts
ESCROW_ADDRESS=
# JSON [{symbol,address,decimals,feed}]; empty = the PAYWITH_TOKENS entries that have a feed
ESCROW_TOKENS=
ESCROW_HAIRCUT_BPS=300
ESCROW_MAX_PRICE_AGE_S=302400
ESCROW_START_BLOCK=
ESCROW_FINALITY=finalized
ESCROW_REORG_HORIZON_BLOCKS=864000

# ---- Pay with $ANYR in escrow (off unless ANYR_TOKEN_ADDRESS is set) --------------------------
# ANYR sent to ESCROW_ADDRESS is credited to the sending wallet like a Stock Token (same finality,
# reorganization and idempotency rules), but priced from its Uniswap v4 pools instead of a feed:
# the lower of spot and the BUYBACK_TWAP_MINUTES average through ANYR_POOL_LEGS, which must chain
# from ANYR_TOKEN_ADDRESS to USDG. No price when a pool is unreadable, below a leg's minLiquidity, or
# its spot is more than ANYR_ESCROW_MAX_DEVIATION (default BUYBACK_MAX_DEVIATION) from the average:
# the deposit then waits as `pending` (stage `awaiting_price`; GET /api/v1/escrow/anyr/price says why, and
# /ready lists an `anyr_price_unavailable` warning that does not fail readiness). ANYR is thin and volatile:
# in its first day, spot was more than 5% from the 30-minute average in about 6 of 10 readings (and more
# than 25% in about 1 of 14), so at the 5% default ANYR deposits can wait for hours. The credit always uses
# the lower of spot and average, so a wider ANYR_ESCROW_MAX_DEVIATION cannot credit above the average; the
# per-deposit limit below bounds what one price reading can cost.
# ANYR_TOKEN_DECIMALS is checked against the token contract before anything is credited.
# One deposit is credited at most ANYR_ESCROW_MAX_USD_PER_DEPOSIT (after the haircut). Anything above
# is not credited: the deposit is flagged for operator review (it fails the escrow_reconciliation
# readiness check until escrow_deposits.reviewed_at is set), so refund or credit the rest by hand.
ANYR_TOKEN_ADDRESS=
ANYR_TOKEN_SYMBOL=ANYR
ANYR_TOKEN_DECIMALS=18
ANYR_ESCROW_HAIRCUT_BPS=0                # vs ESCROW_HAIRCUT_BPS for Stock Tokens
ANYR_ESCROW_MAX_USD_PER_DEPOSIT=250
ANYR_ESCROW_MAX_DEVIATION=               # empty = BUYBACK_MAX_DEVIATION
# JSON v4 legs pricing ANYR in USDG (ETH is currency 0x0; sign 1 prices currency0 in currency1, -1 the
# inverse). Optional per leg: "minLiquidity" (raw v4 liquidity, as a string); below it the pool is too
# thin to price. Also the buyback keeper's off-chain second opinion. Mainnet values, verified on-chain,
# are in config/rhc-mainnet.json (anyr): ANYR_TOKEN_ADDRESS=0xa4dDF89A40A35264E9D7F896a1ef01C59b1e977a and
# ANYR->ETH->USDG legs:
# [{"key":{"currency0":"0x0000000000000000000000000000000000000000","currency1":"0xa4dDF89A40A35264E9D7F896a1ef01C59b1e977a","fee":0,"tickSpacing":200,"hooks":"0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044"},"sign":-1,"minLiquidity":"15000000000000000000000"},{"key":{"currency0":"0x0000000000000000000000000000000000000000","currency1":"0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168","fee":100,"tickSpacing":1,"hooks":"0x0000000000000000000000000000000000000000"},"sign":1}]
ANYR_POOL_LEGS=
BUYBACK_TWAP_MINUTES=30
BUYBACK_MAX_DEVIATION=0.05

# ---- $ANYR holder perks (the token is ANYR_TOKEN_ADDRESS above) ---------------------------------
# Free inference credits for holders: `bun scripts/holder-credits.ts --budget-usd <usd> ...` snapshots
# balances (dry run by default) and, with --apply --period <id>, credits each holder's wallet account
# once per period. Credits pay for inference only; they are never withdrawable.
ANYR_TOKEN_DEPLOY_BLOCK=             # first block with $ANYR Transfer logs (mainnet: 75340370, the mint)
HOLDER_CREDITS_EXCLUDE=              # comma list never credited: treasury, team wallets (zero, 0x…dEaD, the token, V4_POOL_MANAGER, ESCROW_ADDRESS are always excluded, and contracts by default)
# Live holder tiers, read from the wallet's balance (cached 5 min; no tier when the RPC fails) for calls
# made with wallet sign-in keys or paid per call by a wallet. rpm_multiplier scales the key's rpm/tpm
# limits; discount_bps lowers Anyroute's own fee rates (PER_CALL_MARGIN_BPS, BYOK_FEE_BPS) by that much,
# never below 0: prepaid calls carry no margin, so there the discount is 0. Off unless
# ANYR_TOKEN_ADDRESS is also set. Example:
# HOLDER_TIERS=[{"name":"Holder","min":"100000","rpm_multiplier":2,"discount_bps":50},{"name":"Whale","min":"1000000","rpm_multiplier":5,"discount_bps":100}]
HOLDER_TIERS=

# ---- IPX: inference price index (off unless IPX_ENABLED) ---------------------------------------
# GET /api/v1/ipx/:class serves the volume-weighted USDG price per 1,000,000 tokens for a model class,
# one value per whole hour, computed from real generations (completed, paid, not BYOK, not cached, with
# a signed receipt), plus the trailing-24h volume, a THIN flag and a merkle root over the hour's receipt
# leaves. `bun scripts/ipx-feed.ts --class <id>` prints the IPXFeed.update arguments (dry run; --send
# posts them and needs IPX_KEEPER_PRIVATE_KEY, which does not belong in the router's environment).
IPX_ENABLED=false
# Class id -> model ids (a model belongs to at most one class). Default: IPX-OPEN-70B = meta-llama/llama-3.3-70b-instruct.
# IPX_CLASSES={"IPX-OPEN-70B":["meta-llama/llama-3.3-70b-instruct"]}
IPX_CLASSES=
IPX_THIN_USDG=50000                  # trailing-24h volume (USDG) below which a class is THIN
IPX_MAX_ACCOUNT_SHARE_BPS=10000      # cap one account's share of a window's volume; 10000 = no cap
IPX_ATTESTED_ONLY=true               # count only fills whose receipt carries an attestation hash

# ---- IPX oracle publisher: signed index price updates (off unless IPX_ENABLED and IPX_ORACLE_ENABLED) ------
# The worker job `ipx-oracle` signs an update per class every IPX_ORACLE_INTERVAL_S from the latest IPX sample and
# stores it; GET /api/v1/ipx/:class/oracle serves it with the public key and how to verify it, and
# `bun scripts/ipx-oracle-verify.ts` checks one. Rules: a THIN class is marked thin with reduce_only; an update is
# valid for IPX_ORACLE_STALE_AFTER_S and a consumer must halt after that; the price moves at most
# IPX_ORACLE_MAX_MOVE_BPS per update (with an alert); IPX_ORACLE_HALTED (or PUT /api/v1/ipx/oracle/halt with the
# operator token) freezes publishing. Sinks are off unless listed. See deploy/ipx-perp/README.md.
IPX_ORACLE_ENABLED=false
IPX_ORACLE_PRIVATE_KEY=              # dedicated oracle key (0x + 32 bytes), worker only; signs messages, holds no funds
IPX_ORACLE_PUBLIC_KEY=               # the public half, for API replicas that do not hold the private key
IPX_ORACLE_ALGORITHM=ed25519         # or secp256k1-eip191
IPX_ORACLE_CLASSES=                  # comma list of IPX class ids; default: all
IPX_ORACLE_INTERVAL_S=300
IPX_ORACLE_STALE_AFTER_S=1800        # at least twice the interval
IPX_ORACLE_MAX_MOVE_BPS=1000
IPX_ORACLE_HALTED=false
IPX_ORACLE_PUBLISHERS=               # comma list: onchain, https
IPX_ORACLE_FEEDS=                    # {"IPX-OPEN-70B":"0x<IPXFeed address>"}
IPX_ORACLE_ONCHAIN_SUBMIT=false      # true: post to IPXFeed with IPX_KEEPER_PRIVATE_KEY; false: calldata only
IPX_ORACLE_PUSH_CONFIG=              # path to a JSON file describing the HTTPS push (see deploy/ipx-perp/push-config.example.json)
IPX_KEEPER_PRIVATE_KEY=              # IPXFeed keeper; only with IPX_ORACLE_ONCHAIN_SUBMIT, on a worker with no other signing key

# ---- Blind tokens: unlinkable paid access (Privacy Pass, RFC 9578 type 0x0002) --------------------
# Off unless ANYROUTE_FEATURE_BLIND=true. Buyers turn credits into tokens worth 1000, 10000 or 100000
# token-units (POST /api/v1/blind/purchase; keys at GET /api/v1/blind/keys) and spend them with
# `Authorization: PrivateToken token=<base64url>` on chat and embeddings. A token pays for one request whose
# worst-case cost is at most its value; the unspent part is not refunded. Issuer keys are 2048-bit RSA, one per
# denomination per epoch, encrypted at rest with APP_SECRET and rotated every BLIND_EPOCH_SECONDS by the
# `blind-key-rotation` job (add it to WORKER_JOBS on the worker role). What is unlinkable is what the router stores: a
# token cannot be tied to the purchase that made it. Network addresses and timing are not hidden by this feature;
# hiding them needs an anonymizing network path, which this feature does not provide.
ANYROUTE_FEATURE_BLIND=false
BLIND_UNIT_PRICE_USD=0.000002        # value of one token-unit: 1000 units = $0.002, 100000 units = $0.20. A key keeps the price it was created with; keys are made an epoch ahead, so a change reaches tokens from the epoch after next
BLIND_EPOCH_SECONDS=604800           # issuer key lifetime (one week)
BLIND_REDEEM_GRACE_SECONDS=604800    # tokens stay redeemable this long after their epoch stops issuing
BLIND_MAX_BATCH=32                   # most tokens per purchase request
BLIND_PURCHASE_RPM=10                # purchase requests per key per minute
BLIND_REDEEM_RPM=600                 # calls per minute per client address that present a token (a token carries its own quota)
BLIND_MAX_USD_PER_DAY=100            # most one account may convert into tokens per rolling day

# ---- Oblivious HTTP gateway and the unlinkable lane (RFC 9458) ---------------------------------------
# Off unless OHTTP_ENABLED=true, which also needs ANYROUTE_FEATURE_BLIND=true (the lane is paid with blind tokens).
# The router then unwraps message/ohttp-req sent by a relay (POST /api/v1/ohttp/gateway), serves it on its own chat,
# embeddings and blind-purchase routes, and wraps the response; GET /api/v1/ohttp/keys is the key configuration and
# GET /api/v1/ohttp/key-list the signed, hash-chained key history. Lane "unlinkable" is served only for a request that
# came through a relay from an operator other than OHTTP_GATEWAY_OPERATOR, is paid with a blind token, and is routed
# only to attested providers. A relay hides your address from the router only if its operator is not the router's own
# and does not cooperate with it; the standalone relay in relay/ is meant to be run by someone else.
# Gateway keys are X25519, one per epoch, encrypted at rest with APP_SECRET, created an epoch ahead and destroyed when
# their window ends by the `ohttp-key-rotation` job (add it to WORKER_JOBS on the worker role).
OHTTP_ENABLED=false
OHTTP_KEY_EPOCH_SECONDS=86400        # gateway key lifetime (one day)
OHTTP_KEY_GRACE_SECONDS=86400        # a key keeps opening requests this long after its epoch ends (at most 100 epochs)
OHTTP_MAX_REQUEST_BYTES=8388608      # largest encapsulated request
OHTTP_MAX_RESPONSE_BYTES=8388608     # largest response the gateway will wrap
OHTTP_RELAY_RPM=6000                 # gateway requests per minute per authenticated relay
OHTTP_DIRECT_RPM=60                  # gateway requests per minute per client address that did not come through a relay
OHTTP_PAD_BYTES=256                  # responses are zero-padded to a multiple of this (0 = none)
OHTTP_GATEWAY_OPERATOR=AnyRoute      # how this router's own operator appears in RELAY_OPERATORS; its relays do not count as independent
OHTTP_MIN_RELAY_OPERATORS=2          # production needs relays from at least this many other operators
# The relays clients may use, published at GET /api/v1/relays. key_id names the credential the relay presents to the
# gateway (Authorization: Bearer <key_id>:<secret>); secret_sha256 is the hex SHA-256 of that secret, which the relay
# operator generates and keeps. Example (one line):
# RELAY_OPERATORS=[{"operator":"Example Relay Co","url":"https://relay.example.org/relay","key_id":"example-1","secret_sha256":"<64 hex>"}]
RELAY_OPERATORS=

# ---- Tor (optional) --------------------------------------------------------------------------------
# deploy/onion runs a v3 onion service that forwards to this router over a private network. Clients that use it hide
# their network address from the router. ONION_ADDRESS is that service's hostname, published at GET /api/v1/status and
# offered to Tor Browser in an Onion-Location header on the site's pages. ONION_PROXY_SECRET is the secret the onion
# proxy sends in X-Anyroute-Onion (use the same value there): a request that carries it is an onion request, and only then.
# Onion requests have no client address, so calls without an API key (unkeyed chat and embeddings, new keys, wallet
# sign-in challenges, the paymaster, the gateway's direct limit) share one bucket per limit, ONION_POOL_MULTIPLIER times
# the limit of one address and apart from every real address. Calls with an API key are limited per key as usual.
# A comma list of up to three secrets lets you rotate: add the new one here, switch the proxy, then drop the old one.
ONION_ADDRESS=
ONION_PROXY_SECRET=
ONION_POOL_MULTIPLIER=10

# ---- Routing / health / canaries / attestation ----------------------------------------------
OUTAGE_WINDOW_MS=30000
HEALTH_PROBE_INTERVAL_MS=15000
PROVIDER_TIMEOUT_MS=120000
FIRST_TOKEN_TIMEOUT_MS=45000
MAX_PROVIDER_ATTEMPTS=4
# Selection weight = uptime x quality x attested_bonus / price^2, per lane. The bonus applies to endpoints served
# under the attested class (attested retention and a fresh, verified attestation). At least 1.
ATTESTED_BONUS_PUBLIC=1.25
ATTESTED_BONUS_ATTESTED=1
ATTESTED_BONUS_UNLINKABLE=1
CANARIES=true
CANARY_INTERVAL_MS=3600000
SHADOW_DAYS=7
ATTESTATION_INTERVAL_MS=600000
ATTESTATION_HISTORY_DAYS=30          # days of attestor, canary and probe events kept for GET /api/v1/attestation/summary; 0 records nothing and turns the two history endpoints off
ALLOW_DEV_ATTESTATION=false          # never true in production
TDX_VERIFIER_URL=                    # DCAP quote verification service (required for TDX providers)
TDX_VERIFIER_KEY=
NVIDIA_NRAS_URL=https://nras.attestation.nvidia.com/v3/attest/gpu
ATTESTATION_VERIFIERS=dcap           # comma list of dcap, intel-ta, dstack, phala; every listed verifier must accept a quote
INTEL_TA_URL=https://api.trustauthority.intel.com/appraisal/v2/attest
INTEL_TA_JWKS_URL=https://portal.trustauthority.intel.com/certs
INTEL_TA_API_KEY=                    # required when intel-ta is listed
DSTACK_VERIFIER_URL=                 # a dstack verifier's verify endpoint; required when dstack is listed
DSTACK_VERIFIER_KEY=
PHALA_VERIFIER_URL=https://cloud-api.phala.com/api/v1/attestations/verify  # Phala's public quote verifier, used when phala is listed (no TCB status: pair it with dcap or intel-ta to enforce one)
# Measurements (off by default): record the image/compose/model digests bound into verified quotes, look them up in
# Rekor and prepare MeasurementRegistry.register() calldata. Nothing is submitted on chain.
MEASUREMENTS_ENABLED=false
MEASUREMENTS_INTERVAL_MS=300000
REKOR_URL=https://rekor.sigstore.dev
REKOR_PUBLIC_KEY=                    # PEM of the log's checkpoint key; without it checkpoints are not verified
MEASUREMENT_PUBLIC_KEY=              # PEM (ECDSA P-256) of the key that signs measurement bundles; setting it turns on bundle checking (public key only)
MEASUREMENT_REGISTRY_ADDRESS=        # only used as the target of the prepared calldata and for read-back
# Per-host anchoring of enclave receipts (off by default: no job, no route). The `host-anchor` job (add it to WORKER_JOBS
# on the worker that holds ANCHORER_PRIVATE_KEY, next to receipts-anchor) collects each attested sidecar's receipt leaves,
# keeps those signed by the receipt key its verified attestation binds, and roots them per host and interval. With a
# ReceiptAnchor address and the anchorer key it posts each root with anchorAttested; otherwise roots stay off chain.
# Set HOST_ANCHOR_ENABLED on the api role as well, to serve /api/v1/host-anchors/proof.
HOST_ANCHOR_ENABLED=false
HOST_ANCHOR_INTERVAL_MS=3600000
HOST_ANCHOR_TOKENS=                  # JSON {"<provider id>": "<that sidecar's SIDECAR_ANCHOR_TOKEN>"}; worker role only

# ---- The Lane: open-weights variants, day-zero pipeline, creator claims -----------------------------------
# A model that is abliterated or native_low_refusal (declared with PUT /api/v1/models/{author}/{slug}/lane) is served only
# by providers under attested retention whose verified attestation reports the in-enclave classifier as enabled.
# Day-zero pipeline (off by default): watch Hugging Face for new fine-tunes of the listed base models, check their
# license, and create candidates. A candidate is served only after an operator approves it and an attested provider
# that reports the classifier serves it. Add `dayzero` to WORKER_JOBS on the worker role.
DAYZERO_ENABLED=false
DAYZERO_INTERVAL_MS=900000
DAYZERO_BASE_MODELS=                 # comma list of Hugging Face repositories (owner/name); required when enabled
DAYZERO_LICENSES=mit,apache-2.0      # license ids (model card metadata) a base model and a derivative may carry
DAYZERO_KEYWORDS=abliterated,uncensored,decensored,unfiltered
DAYZERO_MAX_PER_RUN=25
DAYZERO_MAX_REFUSAL_RATE=0.25        # largest share of the benign probe set a candidate may refuse
DAYZERO_MIN_CAPABILITY=0.8           # smallest share of the exact-check set a candidate must answer correctly
DAYZERO_MIN_CANARY=0.75
# Creator royalty claims (POST /api/v1/creators/claims): the rate is DEFAULT_ROYALTY_BPS (500 = 5%, at most 2000).
LANE_CLAIM_TTL_S=86400
LANE_CLAIM_FILE=anyroute-claim.txt

# ---- Gateway features -----------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=anyroute
CACHE_TTL_S=3600
SEMANTIC_CACHE_THRESHOLD=0.97
# Council mode (model "anyroute/council": member models plus a judge) and dual verification (verify: "dual"). Off by default.
ANYROUTE_FEATURE_COUNCIL=false
ANYROUTE_COUNCIL_MODELS=             # comma list of 2-5 model ids used when a request sends no council.models
ANYROUTE_COUNCIL_JUDGE=              # judge model id used when a request sends no council.judge
ANYROUTE_COUNCIL_MODE=judge          # judge | fuse
# Private RAG (POST /api/v1/rag): the most one request may carry. Document text is never stored.
RAG_MAX_DOCUMENTS=200
RAG_MAX_BYTES=2097152                # total UTF-8 bytes of document text
RAG_MAX_CHUNKS=2000
RAG_MAX_EMBEDDING_CALLS=64           # embeddings calls one request may make
DEFAULT_RPM=600
DEFAULT_TPM=0
UNAUTH_RPM=60
NEW_KEYS_PER_HOUR=10
TELEGRAM_BOT_TOKEN=                  # optional: BotFather token; runs the Telegram bot (long polling; users can /private on to chat on the attested lane only). Empty = bot off

# ---- Anthropic Messages endpoint (POST /v1/messages) ------------------------------------------------------
# Optional. Any catalog model id works as sent. To let a client that sends an Anthropic model name use a catalog model,
# map the name (an exact name, a prefix ending in *, or a lone * for any other name):
#   ANTHROPIC_MODEL_MAP={"claude-sonnet-4-5":"meta-llama/llama-3.3-70b-instruct","claude-haiku-*":"qwen/qwen3-32b"}
ANTHROPIC_MODEL_MAP=
