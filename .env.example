# ---- Core ------------------------------------------------------------------------------
ANYROUTE_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
# pglite://.data/pglite (zero-setup, in-process Postgres) | postgres://user:pass@host:5432/anyroute
DATABASE_URL=pglite://.data/pglite
# Optional: enables Redis rate limits/cache and BullMQ jobs (required for multiple replicas)
REDIS_URL=
# >= 32 chars in production. Encrypts provider/BYOK keys and receipt keys at rest.
APP_SECRET=
# Operator token for /trpc operator procedures (>= 24 chars in production)
ADMIN_TOKEN=
LOG_LEVEL=info
# Behind exactly one reverse proxy/load balancer that appends X-Forwarded-For: true. Otherwise false
# (then every client behind a proxy would share one IP for rate limits; never true without a proxy).
TRUST_PROXY=false

# ---- Robinhood Chain ------------------------------------------------------------------------
CHAIN_ID=4663
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_CONFIRMATIONS=2
CHAIN_START_BLOCK=
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
USDG_EIP712_NAME=Global Dollar
USDG_EIP712_VERSION=1
# Contract addresses (from contracts/deployments/4663.json after deployment)
CREDITS_ADDRESS=
CALLPAY_ADDRESS=
PAYWITHSTOCK_ADDRESS=
PROVIDER_BOND_ADDRESS=
RECEIPT_ANCHOR_ADDRESS=
ROYALTY_ADDRESS=
ANYR_STAKING_ADDRESS=
PAYMASTER_ADDRESS=
CALLPAY_TREASURY=
# Hot keys for operational roles (fund with a little ETH for gas). Keep them in a secret store.
ROUTER_PRIVATE_KEY=                 # PayWithStock.payCall + relays EIP-3009 per-call payments
SETTLEMENT_PRIVATE_KEY=             # Credits.postSpentRoot/sweep, Royalty.stream, payouts, margin
ANCHORER_PRIVATE_KEY=               # ReceiptAnchor.anchor + signing-key registry
PAYMASTER_SIGNER_KEY=               # AnyrPaymaster verifying signer (ERC-7677 service)
SLASHER_PRIVATE_KEY=                # dev only; in production the 3-of-5 Safe executes slashes

# ---- Economics -----------------------------------------------------------------------------
PER_CALL_MARGIN_BPS=100             # <= 100 (1%), charged only on per-call (402) payments
PROVIDER_FEE_BPS=200                # 2% provider-side settlement fee (prepaid is 0% to callers)
BYOK_FEE_BPS=0
PER_CALL_MAX_USD=25
PER_CALL_QUOTE_TTL_S=300
# x402 (exact scheme): agents sign a USDG transferWithAuthorization to X402_PAY_TO and send it as X-PAYMENT; the router
# relays it (ROUTER_PRIVATE_KEY, funded with a little ETH for gas) and serves the call. Needs no CallPay contract.
# On when X402_PAY_TO is set to a wallet the operator controls (it is not a contract that indexes deposits).
X402_PAY_TO=
X402_NETWORK=robinhood-chain        # network name advertised in `accepts` (eip155:<CHAIN_ID> is accepted too)

# ---- Pay with Stock Tokens -------------------------------------------------------------------
# JSON list of registered Stock Tokens (see config/rhc-mainnet.json for verified addresses)
PAYWITH_TOKENS=[{"symbol":"NVDA","address":"0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC","decimals":18,"feed":"0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15"}]
PAYWITH_THRESHOLD_USD=1
PAYWITH_MAX_AGE_H=24
PAYWITH_MAX_DEBT_USD=5
PAYWITH_MAX_SLIP_BPS=100
PAYWITH_CAP_HAIRCUT_BPS=1000

# ---- Stock escrow payments (PAYMENTS_MODE=escrow) ---------------------------------------------
# Customers sign in with their wallet and transfer a listed Stock Token to ESCROW_ADDRESS (a wallet
# you control; only its public address goes here). Once the transfer's block is at or below the
# chain's ESCROW_FINALITY block (and has CHAIN_CONFIRMATIONS), the sending wallet's account is
# credited at the Chainlink price minus ESCROW_HAIRCUT_BPS; until then it shows as pending_finality.
# On Robinhood Chain `finalized` trails the head by ~15-21 minutes and `safe` by ~8-14 minutes.
# Credits are re-verified for ESCROW_REORG_HORIZON_BLOCKS (~1 day at ~10 blocks/s); one whose transfer
# left the canonical chain is reversed and flagged until escrow_deposits.reviewed_at is set.
# Runs without the Anyroute contracts, which must then be left unset. Set ESCROW_START_BLOCK to the
# block at or before the escrow address was first published, so no earlier transfer is missed.
PAYMENTS_MODE=contracts
ESCROW_ADDRESS=
# JSON [{symbol,address,decimals,feed}]; empty = the PAYWITH_TOKENS entries that have a feed
ESCROW_TOKENS=
ESCROW_HAIRCUT_BPS=300
ESCROW_MAX_PRICE_AGE_S=302400
ESCROW_START_BLOCK=
ESCROW_FINALITY=finalized
ESCROW_REORG_HORIZON_BLOCKS=864000

# ---- Routing / health / canaries / attestation ----------------------------------------------
OUTAGE_WINDOW_MS=30000
HEALTH_PROBE_INTERVAL_MS=15000
PROVIDER_TIMEOUT_MS=120000
FIRST_TOKEN_TIMEOUT_MS=45000
MAX_PROVIDER_ATTEMPTS=4
CANARIES=true
CANARY_INTERVAL_MS=3600000
SHADOW_DAYS=7
ATTESTATION_INTERVAL_MS=600000
ALLOW_DEV_ATTESTATION=false          # never true in production
TDX_VERIFIER_URL=                    # DCAP quote verification service (required for TDX providers)
TDX_VERIFIER_KEY=
NVIDIA_NRAS_URL=https://nras.attestation.nvidia.com/v3/attest/gpu

# ---- Gateway features -----------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=anyroute
CACHE_TTL_S=3600
SEMANTIC_CACHE_THRESHOLD=0.97
DEFAULT_RPM=600
DEFAULT_TPM=0
UNAUTH_RPM=60
NEW_KEYS_PER_HOUR=10
TELEGRAM_BOT_TOKEN=                  # optional: BotFather token; runs the Telegram bot (long polling). Empty = bot off
