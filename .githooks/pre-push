#!/usr/bin/env bash
# Scan the entire outgoing history, including merge parents. Never exclude commits
# merely because some local remote-tracking ref already points at them.
set -euo pipefail
guard="$(cd "$(dirname "$0")" && pwd)/publish-guard.sh"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  "$guard" range "$local_sha"
done
