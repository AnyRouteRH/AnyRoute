{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@anyroute/client": ["../../packages/client/src/index.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}
