{
  "x402Version": 1,
  "items": [
    {
      "resource": "https://anyroute.tech/api/v1/chat/completions",
      "type": "http",
      "x402Version": 1,
      "accepts": [
        {
          "scheme": "exact",
          "network": "robinhood-chain",
          "maxAmountRequired": "25000000",
          "resource": "https://anyroute.tech/api/v1/chat/completions",
          "description": "OpenAI-compatible chat completion on any of 350+ models, with a signed receipt. Priced per request; the 402 reply quotes the exact amount.",
          "mimeType": "application/json",
          "payTo": "<X402_PAY_TO>",
          "maxTimeoutSeconds": 300,
          "asset": "0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168",
          "extra": { "name": "Global Dollar", "version": "1", "chainId": 4663 },
          "outputSchema": {
            "input": {
              "type": "http",
              "method": "POST",
              "bodyType": "json",
              "bodyFields": {
                "model": { "type": "string", "required": true, "description": "Any id from GET /api/v1/models, e.g. meta-llama/llama-3.3-70b-instruct" },
                "messages": { "type": "array", "required": true, "description": "OpenAI chat messages" },
                "max_tokens": { "type": "number", "required": false, "description": "Caps the quoted price" },
                "stream": { "type": "boolean", "required": false },
                "provider": { "type": "object", "required": false, "description": "{\"lane\":\"attested\"} sends only to providers whose enclave the router verified, or refuses with nothing sent" }
              }
            },
            "output": {
              "type": "object",
              "description": "OpenAI chat.completion plus usage.cost (USD) and receipt {id, sig, key_id, alg, payload}"
            }
          }
        }
      ],
      "metadata": {
        "name": "Anyroute chat completions",
        "tags": ["attested", "tee", "uncensored-ok"],
        "category": "ai-inference",
        "priceHint": "Per request: the model's per-token price (GET /api/v1/models) times the request's prompt and max_tokens, plus a 1% per-call margin; at most 25 USDG.",
        "docs": "https://anyroute.tech/docs",
        "models": "https://anyroute.tech/api/v1/models"
      }
    },
