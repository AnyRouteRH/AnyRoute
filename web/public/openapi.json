{
  "openapi": "3.1.0",
  "info": {
    "title": "Anyroute API",
    "version": "1.0.0",
    "description": "Scope: a documented subset of the public HTTP API that the Anyroute router implements. It covers the model catalog, chat completions, embeddings, key creation and listing, generations, status, health and receipts. Other implemented routes (for example legacy completions, the /v1 aliases, key updates, credits, Stock Token payments, BYOK, teams, wallet sign-in, rankings, provider onboarding and the paymaster) are not described here, and a route's absence from this document does not mean it is absent from the router. Endpoint availability, payment modes and model capabilities are deployment-specific. Errors share the OpenRouter-shaped ApiError body; the 4xx responses each operation can return are declared with the reusable responses in components.responses.",
    "contact": { "name": "AnyRoute support", "email": "Anyroute1@atomicmail.io" },
    "license": { "name": "PolyForm Noncommercial License 1.0.0", "identifier": "PolyForm-Noncommercial-1.0.0" },
    "x-api-coverage": "subset"
  },
  "externalDocs": { "description": "Developer documentation and endpoint overview", "url": "/docs/" },
  "servers": [{ "url": "/", "description": "Current router origin" }],
  "security": [{}],
  "tags": [
    { "name": "Models", "description": "Public model catalog and capabilities." },
    { "name": "Chat", "description": "Chat completion requests and streaming responses." },
    { "name": "Embeddings", "description": "Authenticated prepaid embedding requests." },
    { "name": "Keys", "description": "API key creation and account key metadata." },
    { "name": "Generations", "description": "Authenticated generation summaries and details." },
    { "name": "Status", "description": "Public process and router configuration status." },
    { "name": "Receipts", "description": "Public signed receipt retrieval and verification." },
    {"name": "Saved Routes", "description": "Named routing policies callable as model @route/<slug>."},
    {"name": "Agent Sessions", "description": "Short-lived, budget-capped session keys for agent runs."},
    {"name": "Spend Watch", "description": "Spend reports, key budgets and alert rules."},
    {"name": "MCP", "description": "Remote Model Context Protocol server: every live model as a tool."}
  ],
  "paths": {
    "/api/v1/models": {
      "get": {
        "tags": ["Models"], "operationId": "listModels", "summary": "List public live models",
        "parameters": [{ "name": "supported_parameters", "in": "query", "required": false, "description": "Comma-separated capabilities to require.", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Models matching the requested capabilities.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Model" } } } } } } }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/api/v1/chat/completions": {
      "post": {
        "tags": ["Chat"], "operationId": "createChatCompletion", "summary": "Create a chat completion",
        "description": "Supports standard JSON responses and Server-Sent Events when stream is true. A model must support requested capabilities such as tools or response_format. Auth may use a bearer key, wallet authentication, or the per-call payment flow. A 402 response can contain a quote; follow its payment instructions before retrying the exact request.",
        "security": [{ "BearerAuth": [] }, { "WalletAuth": [] }, {}],
        "parameters": [{ "$ref": "#/components/parameters/Referer" }, { "$ref": "#/components/parameters/Title" }, { "$ref": "#/components/parameters/Payment" }, { "$ref": "#/components/parameters/PayWith" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } } },
        "responses": {
          "200": { "description": "Completion JSON, or SSE events followed by data: [DONE] when stream is true.", "content": { "application/json": { "schema": { "type": "object" } }, "text/event-stream": { "schema": { "type": "string", "description": "SSE data events; event data carries JSON chunks." } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "402": { "$ref": "#/components/responses/PaymentRequired" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "429": { "$ref": "#/components/responses/TooManyRequests" }, "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/embeddings": {
      "post": {
        "tags": ["Embeddings"], "operationId": "createEmbeddings", "summary": "Create embeddings",
        "description": "Requires an authenticated prepaid API key. Input may be a string or a non-empty array with at most 2048 items.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmbeddingRequest" } } } },
        "responses": { "200": { "description": "Embedding response with usage and signed receipt.", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "receipt"], "properties": { "data": { "type": "array", "items": { "type": "object" } }, "receipt": { "$ref": "#/components/schemas/Receipt" } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "402": { "$ref": "#/components/responses/PaymentRequired" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "429": { "$ref": "#/components/responses/TooManyRequests" }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/api/v1/keys": {
      "post": {
        "tags": ["Keys"], "operationId": "createKey", "summary": "Create a root key or authenticated sub-key",
        "description": "Without Authorization, creates an independent root key with an empty balance. With an authorized management or admin key, creates a virtual sub-key under that account. The response includes the new secret once; store it securely. Root-key creation does not fund the key. Never send a secret in a query string.",
        "security": [{ "BearerAuth": [] }, {}],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KeyCreateRequest" } } } },
        "responses": { "201": { "description": "New key metadata and one-time key secret.", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "key", "deposit"], "properties": { "data": { "$ref": "#/components/schemas/Key" }, "key": { "type": "string", "readOnly": true, "description": "Secret returned only on creation." }, "deposit": { "type": "object" } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "429": { "$ref": "#/components/responses/TooManyRequests" }, "default": { "$ref": "#/components/responses/ApiError" } }
      },
      "get": {
        "tags": ["Keys"], "operationId": "listKeys", "summary": "List keys for the authenticated account",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Key metadata for the authenticated account.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Key" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/api/v1/generations": {
      "get": {
        "tags": ["Generations"], "operationId": "listGenerations", "summary": "List generation summaries",
        "description": "Returns summaries for the authenticated account. The response's next value can be passed as before to request an older page.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "before", "in": "query", "required": false, "description": "Opaque cursor returned in next. Pass it through without parsing; current versions may return a legacy ISO-8601 timestamp.", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Generation summaries and the next page cursor, if any.", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "next"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/GenerationSummary" } }, "next": { "type": ["string", "null"] } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/api/v1/generation": {
      "get": {
        "tags": ["Generations"], "operationId": "getGeneration", "summary": "Read one generation record",
        "description": "Returns a full record only to the account owner or the authenticated paying wallet. The id is supplied as a query parameter because that is the implemented route; do not put API keys or other credentials in URLs.",
        "security": [{ "BearerAuth": [] }, { "WalletAuth": [] }],
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Generation record and receipt details.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "properties": { "receipt": { "$ref": "#/components/schemas/Receipt" } } } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/api/v1/status": {
      "get": { "tags": ["Status"], "operationId": "getStatus", "summary": "Read public router configuration", "description": "Returns published runtime configuration, chain public fields, job state and catalog counts. It is not an uptime guarantee.", "responses": { "200": { "description": "Current public status snapshot.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } } } } }, "default": { "$ref": "#/components/responses/ApiError" } } }
    },
    "/health": {
      "get": { "tags": ["Status"], "operationId": "getHealth", "summary": "Check process response", "description": "Returns { ok: true } when this process responds. It does not establish dependency health or uptime.", "responses": { "200": { "description": "Process responded.", "content": { "application/json": { "schema": { "type": "object", "required": ["ok"], "properties": { "ok": { "const": true } } } } } } } }
    },
    "/api/v1/receipts/verify": {
      "post": {
        "tags": ["Receipts"], "operationId": "verifyReceipt", "summary": "Verify a signed receipt",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReceiptVerificationRequest" } } } },
        "responses": { "200": { "description": "Receipt verification result.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/api/v1/receipts/{id}": {
      "get": {
        "tags": ["Receipts"], "operationId": "getReceipt", "summary": "Read a public receipt proof",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Signed receipt and optional anchor proof.", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/Receipt" } } } } } }, "404": { "$ref": "#/components/responses/NotFound" }, "default": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/mcp": {
      "post": {
        "tags": ["MCP"], "operationId": "mcp", "summary": "AnyRoute MCP (Streamable HTTP, stateless JSON-RPC 2.0)",
        "description": "One JSON-RPC 2.0 message per request: initialize, ping, tools/list and tools/call (list_models, chat, get_receipt, verify_receipt), plus notifications, which get an empty 202. Replies are JSON, never a stream; there are no sessions. Only the chat tool needs an API key, which it spends like /api/v1/chat/completions. Malformed JSON or a batch gets HTTP 400, a request carrying a foreign Origin header gets 403 and GET gets 405; all three carry a JSON-RPC error body.",
        "security": [{"BearerAuth": []}, {}],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["jsonrpc", "method"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": ["string", "integer"] }, "method": { "type": "string" }, "params": { "type": "object" } } } } } },
        "responses": {
          "200": { "description": "A JSON-RPC 2.0 response: a result, or an error object with a JSON-RPC code.", "content": { "application/json": { "schema": { "type": "object", "required": ["jsonrpc", "id"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": ["string", "integer", "null"] }, "result": { "type": "object" }, "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "integer" }, "message": { "type": "string" } } } } } } } },
          "202": { "description": "Notification accepted; the body is empty." }
        }
      }
    },
    "/api/v1/routes": {"get": {"tags": ["Saved Routes"], "operationId": "listRoutes", "summary": "List the account's saved routes", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "Saved routes, sorted by slug.", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/SavedRoute"}}, "limit": {"type": "integer"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}, "post": {"tags": ["Saved Routes"], "operationId": "createRoute", "summary": "Save a routing policy callable as model @route/<slug>", "description": "Owner or admin. No prompt text is stored.", "security": [{"BearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SavedRouteInput"}}}}, "responses": {"201": {"description": "Created.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/SavedRoute"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"description": "route_exists or route_limit_reached (100 per account).", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}}}},
    "/api/v1/routes/{slug}": {"get": {"tags": ["Saved Routes"], "operationId": "getRoute", "summary": "Get a saved route", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "The route.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/SavedRoute"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}}, "parameters": [{"name": "slug", "in": "path", "required": true, "schema": {"type": "string"}}]}, "patch": {"tags": ["Saved Routes"], "operationId": "updateRoute", "summary": "Update or rename a saved route", "description": "Each config section sent replaces that section; null clears it.", "security": [{"BearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SavedRouteInput"}}}}, "responses": {"200": {"description": "Updated.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/SavedRoute"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"description": "route_exists.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}}, "parameters": [{"name": "slug", "in": "path", "required": true, "schema": {"type": "string"}}]}, "delete": {"tags": ["Saved Routes"], "operationId": "deleteRoute", "summary": "Delete a saved route", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "Deleted.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "object"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}, "parameters": [{"name": "slug", "in": "path", "required": true, "schema": {"type": "string"}}]}},
    "/api/v1/sessions": {"get": {"tags": ["Agent Sessions"], "operationId": "listSessions", "summary": "List the account's agent sessions", "security": [{"BearerAuth": []}], "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "maximum": 200}}, {"name": "before", "in": "query", "schema": {"type": "string", "format": "date-time"}}], "responses": {"200": {"description": "Sessions, newest first.", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/AgentSession"}}, "next": {"type": ["string", "null"]}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}}, "post": {"tags": ["Agent Sessions"], "operationId": "createSession", "summary": "Create a short-lived, budget-capped session key for an agent run", "description": "Owner or admin. The secret is returned once. A session cannot exceed its creator's budget, expiry or model allowlist.", "security": [{"BearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentSessionCreate"}}}}, "responses": {"201": {"description": "Created; includes the one-time key.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"allOf": [{"$ref": "#/components/schemas/AgentSession"}, {"type": "object", "properties": {"key": {"type": "string", "readOnly": true}}}]}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/api/v1/sessions/current": {"get": {"tags": ["Agent Sessions"], "operationId": "currentSession", "summary": "A session key's own remaining budget and time", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "This session.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/AgentSession"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/sessions/{id}": {"get": {"tags": ["Agent Sessions"], "operationId": "getSession", "summary": "Session detail with recent call metadata (never content)", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "The session.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/AgentSession"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}, "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}]}, "delete": {"tags": ["Agent Sessions"], "operationId": "endSession", "summary": "End a session now (idempotent)", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "Ended.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/AgentSession"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}, "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}]}},
    "/api/v1/spend": {"get": {"tags": ["Spend Watch"], "operationId": "getSpend", "summary": "Spend totals, projection, anomaly flag, series, breakdowns and key budgets", "security": [{"BearerAuth": []}], "parameters": [{"name": "period", "in": "query", "schema": {"type": "string", "enum": ["7d", "30d", "90d"], "default": "30d"}}, {"name": "group_by", "in": "query", "schema": {"type": "string", "enum": ["day", "model", "key", "provider"], "default": "day"}}], "responses": {"200": {"description": "Spend report.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/SpendReport"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/spend/alerts": {"get": {"tags": ["Spend Watch"], "operationId": "listSpendAlerts", "summary": "List alert rules and recent firings", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "Rules.", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/SpendAlert"}}, "limits": {"type": "object"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}, "post": {"tags": ["Spend Watch"], "operationId": "createSpendAlert", "summary": "Create an alert rule (threshold, budget_pct or anomaly)", "description": "Owner or admin. Webhooks must be HTTPS to a public address and are delivered at most 3 times per firing.", "security": [{"BearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SpendAlertInput"}}}}, "responses": {"201": {"description": "Created.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/SpendAlert"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"description": "too_many_rules (20 per account).", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}}}},
    "/api/v1/spend/alerts/{id}": {"patch": {"tags": ["Spend Watch"], "operationId": "updateSpendAlert", "summary": "Update an alert rule (kind cannot change; webhook_url null removes it)", "security": [{"BearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SpendAlertInput"}}}}, "responses": {"200": {"description": "Updated.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/SpendAlert"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}, "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}]}, "delete": {"tags": ["Spend Watch"], "operationId": "deleteSpendAlert", "summary": "Delete an alert rule", "security": [{"BearerAuth": []}], "responses": {"200": {"description": "Deleted.", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "object"}}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}, "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}]}}
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Anyroute API key", "description": "Send the key in Authorization. Never put it in a URL." },
      "WalletAuth": { "type": "apiKey", "in": "header", "name": "X-Wallet-Auth", "description": "Wallet authentication header for supported per-call flows." }
    },
    "parameters": {
      "Referer": { "name": "HTTP-Referer", "in": "header", "required": false, "schema": { "type": "string" } },
      "Title": { "name": "X-Title", "in": "header", "required": false, "schema": { "type": "string" } },
      "Payment": { "name": "X-Payment", "in": "header", "required": false, "schema": { "type": "string" }, "description": "Payment data returned by a router quote; do not replay blindly." },
      "PayWith": { "name": "X-Pay-With", "in": "header", "required": false, "schema": { "type": "string" }, "description": "Configured Stock Token symbol for a key with an active session." }
    },
    "responses": {
      "ApiError": { "description": "OpenRouter-shaped API error. A 402 payment response may include payment metadata and is not a signal to repeat payment automatically.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "BadRequest": { "description": "The request body, JSON or parameters failed validation. error.type is, for example, invalid_request, invalid_json or invalid_guardrails; do not retry the same request unchanged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "Unauthorized": { "description": "Authentication is missing or was rejected: no API key, an unknown, disabled or expired key, or invalid wallet authentication. error.type is missing_key, invalid_key, key_disabled, key_expired or invalid_wallet_auth.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "PaymentRequired": { "description": "The call cannot be paid: the balance or the key's budget is insufficient (insufficient_credits, key_budget_exceeded), or a per-call payment is required or was not accepted (payment_required, payment_pending, payment_insufficient, payment_unknown_quote, payment_failed). A payment_required quote is in error.metadata and binds to this exact request; never repeat a payment automatically.", "headers": { "X-Payment-Required": { "description": "Present on a per-call payment quote; names the payment asset.", "schema": { "type": "string" } }, "WWW-Authenticate": { "description": "Present on a per-call payment quote; carries the chain and quote nonce.", "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "Forbidden": { "description": "The key is valid but may not do this: its role does not allow the action, or its model allowlist excludes the model. error.type is forbidden or model_not_allowed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "NotFound": { "description": "The model, provider route, key, team, generation or receipt does not exist or is not visible to the caller. error.type is, for example, not_found, model_not_found or no_providers.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "TooManyRequests": { "description": "A rate limit was reached (rate_limited). Wait for the Retry-After interval before retrying.", "headers": { "Retry-After": { "description": "Seconds to wait before retrying, when the limit reports it.", "schema": { "type": "integer", "minimum": 0 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    },
    "schemas": {
      "ApiError": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "type"], "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "type": { "type": "string" }, "metadata": { "type": "object", "additionalProperties": true } } } } },
      "Model": { "type": "object", "required": ["id", "name", "created", "description", "context_length", "architecture", "pricing", "supported_parameters"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "created": { "type": "integer" }, "description": { "type": "string" }, "context_length": { "type": "integer" }, "architecture": { "type": "object" }, "pricing": { "type": "object", "description": "Prices are returned as decimal strings per token; consult the live response." }, "supported_parameters": { "type": "array", "items": { "type": "string" } }, "data_policy": { "type": "object" }, "attested_available": { "type": "boolean" } } },
      "ChatRequest": { "type": "object", "required": ["messages"], "anyOf": [{ "required": ["model"] }, { "required": ["models"] }], "properties": { "model": { "type": "string", "description": "Public model ID, optionally with a supported routing modifier." }, "models": { "type": "array", "items": { "type": "string" }, "description": "Ordered candidate model IDs." }, "messages": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["role"], "properties": { "role": { "type": "string", "enum": ["system", "developer", "user", "assistant", "tool", "function"] }, "content": { "oneOf": [{ "type": "string" }, { "type": "array" }, { "type": "null" }] } } } }, "stream": { "type": "boolean", "default": false }, "max_tokens": { "type": "integer", "minimum": 1 }, "max_completion_tokens": { "type": "integer", "minimum": 1 }, "tools": { "type": "array", "items": { "type": "object" }, "description": "Requires a model/provider that supports tools." }, "tool_choice": { "oneOf": [{ "type": "string" }, { "type": "object" }] }, "response_format": { "type": "object", "description": "Requires a model/provider that supports the requested response format." }, "provider": { "type": "object", "description": "Provider routing preferences." } }, "additionalProperties": true },
      "EmbeddingRequest": { "type": "object", "required": ["model", "input"], "properties": { "model": { "type": "string" }, "input": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "type": "string" } }] }, "provider": { "type": "object" } } },
      "KeyCreateRequest": { "type": "object", "properties": { "name": { "type": "string", "maxLength": 100 }, "limit": { "type": ["number", "null"], "minimum": 0, "description": "USD budget; alias of budget_usd." }, "budget_usd": { "type": ["number", "null"], "minimum": 0 }, "limit_reset": { "type": ["string", "null"], "enum": ["daily", "weekly", "monthly", null] }, "rpm": { "type": ["integer", "null"], "minimum": 1 }, "tpm": { "type": ["integer", "null"], "minimum": 1 }, "allowed_models": { "type": ["array", "null"], "items": { "type": "string" } }, "team": { "type": ["string", "null"], "description": "Applies to authenticated management-key creation." }, "pay_with_default": { "type": ["string", "null"], "maxLength": 16 }, "disabled": { "type": "boolean" }, "expires_at": { "type": ["string", "null"], "format": "date-time" }, "guardrails": { "type": ["object", "null"], "properties": { "pii": { "type": "string", "enum": ["redact", "block"] }, "deny_patterns": { "type": "array", "maxItems": 50, "items": { "type": "string" } }, "max_input_chars": { "type": "integer", "minimum": 1 }, "redact_output": { "type": "boolean" } } }, "routing": { "type": ["object", "null"], "additionalProperties": true }, "management": { "type": "boolean", "description": "Only honored for authorized authenticated sub-key creation; root-key management is never granted by this field." } }, "additionalProperties": false },
      "Key": { "type": "object", "required": ["hash", "name", "disabled", "created_at"], "properties": { "hash": { "type": "string" }, "name": { "type": "string" }, "disabled": { "type": "boolean" }, "limit": { "type": ["number", "null"] }, "usage": { "type": "number" }, "allowed_models": { "type": ["array", "null"], "items": { "type": "string" } }, "created_at": { "type": "string", "format": "date-time" }, "last_used": { "type": ["string", "null"], "format": "date-time" } } },
      "GenerationSummary": { "type": "object", "required": ["id", "created_at", "model", "total_cost"], "properties": { "id": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" }, "model": { "type": "string" }, "provider_name": { "type": "string" }, "tokens_prompt": { "type": "integer" }, "tokens_completion": { "type": "integer" }, "total_cost": { "type": "number" }, "streamed": { "type": "boolean" }, "cancelled": { "type": "boolean" } } },
      "Receipt": { "type": "object", "properties": { "id": { "type": "string" }, "payload": { "type": "object", "additionalProperties": true }, "sig": { "type": "string" }, "key_id": { "type": "string" }, "leaf": { "type": ["string", "null"] }, "anchor": { "type": ["object", "null"] } } },
      "ReceiptVerificationRequest": { "type": "object", "required": ["payload", "sig", "key_id"], "properties": { "payload": { "type": "object", "additionalProperties": true }, "sig": { "type": "string" }, "key_id": { "type": "string" }, "anchor": { "type": "object", "required": ["root", "proof"], "properties": { "root": { "type": "string" }, "proof": { "type": "array", "items": { "type": "string" } }, "index": { "type": "integer" } } } } },
      "SavedRouteConfig": {"type": "object", "additionalProperties": false, "required": ["models"], "properties": {"models": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}, "description": "Catalog model ids in fallback order; no nested @route/."}, "provider": {"type": ["object", "null"], "description": "Provider preferences: order, only, ignore, allow_fallbacks, sort (price|latency|throughput), data_collection, zdr, require_parameters, max_price."}, "params": {"type": ["object", "null"], "description": "Default request parameters from a closed whitelist (temperature, top_p, top_k, min_p, top_a, frequency_penalty, presence_penalty, repetition_penalty, max_tokens, seed, stop, reasoning, verbosity). Prompt fields are rejected."}}},
      "SavedRoute": {"type": "object", "required": ["id", "slug", "model", "name", "config"], "properties": {"id": {"type": "string"}, "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"}, "model": {"type": "string", "description": "Use as the request model, e.g. @route/my-coder."}, "name": {"type": "string"}, "description": {"type": "string"}, "config": {"$ref": "#/components/schemas/SavedRouteConfig"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "SavedRouteInput": {"type": "object", "additionalProperties": false, "properties": {"slug": {"type": "string"}, "name": {"type": "string", "maxLength": 80}, "description": {"type": "string", "maxLength": 280}, "config": {"$ref": "#/components/schemas/SavedRouteConfig"}}},
      "AgentSession": {"type": "object", "required": ["id", "status", "expires_at"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "status": {"type": "string", "enum": ["active", "ended", "expired", "budget_exhausted"]}, "key_label": {"type": "string"}, "key_hash": {"type": "string"}, "budget_usd": {"type": "number"}, "spent_usd": {"type": "number"}, "reserved_usd": {"type": "number"}, "remaining_usd": {"type": "number"}, "calls": {"type": "integer"}, "last_call_at": {"type": ["string", "null"]}, "allowed_models": {"type": "array", "items": {"type": "string"}}, "metadata": {"type": ["object", "null"]}, "created_at": {"type": "string"}, "expires_at": {"type": "string"}, "time_left_s": {"type": "integer"}, "ended_at": {"type": ["string", "null"]}, "end_reason": {"type": ["string", "null"]}}},
      "AgentSessionCreate": {"type": "object", "additionalProperties": false, "required": ["budget_usd"], "properties": {"name": {"type": "string", "maxLength": 80}, "budget_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}, "ttl_minutes": {"type": "integer", "minimum": 1, "maximum": 1440, "default": 60}, "allowed_models": {"type": "array", "maxItems": 50, "items": {"type": "string"}, "description": "Catalog ids or @route/<slug>; must be within the creator's allowlist."}, "metadata": {"type": "object", "description": "Labels only, at most 2 KB; prompt-like keys are refused."}}},
      "SpendReport": {"type": "object", "description": "Spend for the caller's scope (a management key sees its account; other keys see themselves). UTC calendar.", "properties": {"scope": {"type": "string"}, "period": {"type": "string"}, "group_by": {"type": "string"}, "totals": {"type": "object"}, "anomaly": {"type": "object"}, "series": {"type": "array", "items": {"type": "object", "properties": {"date": {"type": "string"}, "cost_usd": {"type": "number"}, "requests": {"type": "integer"}}}}, "breakdown": {"type": "array", "items": {"type": "object"}}, "budgets": {"type": "array", "items": {"type": "object"}}}},
      "SpendAlert": {"type": "object", "properties": {"id": {"type": "string"}, "kind": {"type": "string", "enum": ["threshold", "budget_pct", "anomaly"]}, "window": {"type": "string", "enum": ["day", "week", "month"]}, "key_hash": {"type": ["string", "null"]}, "threshold_usd": {"type": ["number", "null"]}, "pct": {"type": ["integer", "null"]}, "multiplier": {"type": ["number", "null"]}, "webhook_url": {"type": ["string", "null"], "description": "Masked as https://host/…"}, "enabled": {"type": "boolean"}, "last_fired_at": {"type": ["string", "null"]}, "history": {"type": "array", "items": {"type": "object"}}}},
      "SpendAlertInput": {"type": "object", "additionalProperties": false, "properties": {"kind": {"type": "string", "enum": ["threshold", "budget_pct", "anomaly"]}, "window": {"type": "string", "enum": ["day", "week", "month"]}, "threshold_usd": {"type": "number"}, "pct": {"type": "integer", "minimum": 1, "maximum": 1000}, "multiplier": {"type": "number"}, "key_hash": {"type": "string"}, "webhook_url": {"type": ["string", "null"], "description": "HTTPS, public address only; stored encrypted."}, "enabled": {"type": "boolean"}}}
    }
  }
